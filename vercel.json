{
  "version": 2,
  "buildCommand": "pnpm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/signaling",
      "destination": "/api/signaling"
    },
    {
      "source": "/api/conversations/:path*",
      "destination": "/api/conversations?subpath=:path*"
    },
    {
      "source": "/api/conversations",
      "destination": "/api/conversations"
    },
    {
      "source": "/api/messages/:path*",
      "destination": "/api/conversations?subpath=messages/:path*"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
