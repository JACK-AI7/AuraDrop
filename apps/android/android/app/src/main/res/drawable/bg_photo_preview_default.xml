<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Aurora borealis landscape gradient matching media_1791398332168.png -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:startColor="#1E3C2F"
                android:centerColor="#32855F"
                android:endColor="#543D2B" />
        </shape>
    </item>
    <!-- Foreground terrain wave -->
    <item android:top="45dp">
        <shape android:shape="rectangle">
            <corners
                android:bottomLeftRadius="18dp"
                android:bottomRightRadius="18dp" />
            <gradient
                android:angle="90"
                android:startColor="#2B1E16"
                android:endColor="#4A3423" />
        </shape>
    </item>
    <!-- Subtle border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
