<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <!-- Bright, shimmering, fluid light-ripple effect shooting out from top of screen -->
    <View
        android:id="@+id/view_fluid_ripple"
        android:layout_width="320dp"
        android:layout_height="140dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="-40dp"
        android:background="@drawable/bg_fluid_light_ripple"
        android:alpha="0" />

    <!-- Apple Dynamic Island Floating Card Container -->
    <LinearLayout
        android:id="@+id/pill_card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_notification_card"
        android:elevation="12dp">

        <!-- Top Info Row: AirDrop Badge + Sender Details + File Preview Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Concentric AirDrop radiating wave badge -->
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_airdrop_badge"
                android:contentDescription="AuraDrop Icon" />

            <!-- Sender Name and Status/File Detail -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AuraDrop"
                    android:textColor="#0A84FF"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tv_sender_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nearby Peer"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="1dp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_file_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NameDrop proximity connected • Ready to share"
                    android:textColor="#D1D1D6"
                    android:textSize="12.5sp"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- Preview Thumbnail Box -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_thumbnail_box">

                <ImageView
                    android:id="@+id/iv_file_thumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_preview_file"
                    android:contentDescription="File Preview" />
            </FrameLayout>

        </LinearLayout>

        <!-- Bottom Actions Row: Decline Pill and Accept Pill Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="14dp">

            <!-- Decline Button (Dark Gray Pill) -->
            <FrameLayout
                android:id="@+id/btn_decline_container"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="42dp"
                android:background="@drawable/bg_pill_decline"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Decline"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Accept Button (Apple Blue Pill) -->
            <FrameLayout
                android:id="@+id/btn_accept_container"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="42dp"
                android:background="@drawable/bg_pill_accept"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Accept"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
