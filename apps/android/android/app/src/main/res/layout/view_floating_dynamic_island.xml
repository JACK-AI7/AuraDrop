<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="0dp"
    android:paddingEnd="0dp"
    android:paddingTop="0dp"
    android:paddingBottom="16dp">

    <!-- Bright, shimmering, fluid light-ripple effect shooting out from top of screen -->
    <View
        android:id="@+id/view_fluid_ripple"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="-24dp"
        android:background="@drawable/bg_apple_rim_ripple"
        android:alpha="0" />

    <!-- Apple Dynamic Island Floating Card Container -->
    <LinearLayout
        android:id="@+id/pill_card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="28dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_dynamic_island_card"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:elevation="16dp">

        <!-- Top Section: Left (Concentric Arcs + Avatar + AirDrop Title + Subtitle) | Right (Preview Thumbnail) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Left Details Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="14dp">

                <!-- Concentric AirDrop Radiating Waves with Overlapping Circular Avatar -->
                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp">

                    <ImageView
                        android:id="@+id/iv_airdrop_waves"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="top|start"
                        android:src="@drawable/ic_airdrop_concentric_arcs"
                        android:contentDescription="AirDrop Icon" />

                    <ImageView
                        android:id="@+id/iv_sender_avatar_badge"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_avatar_badge_border"
                        android:contentDescription="Sender Avatar" />
                </FrameLayout>

                <!-- Title: AirDrop (Pure White Bold) -->
                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AirDrop"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="8dp" />

                <!-- Subtitle: [Sender Name] would like to share [count] photos -->
                <TextView
                    android:id="@+id/tv_sender_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nearby Peer would like to share 1 photo"
                    android:textColor="#8E8E93"
                    android:textSize="13.5sp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="1dp"
                    android:layout_marginTop="3dp"
                    android:maxLines="2"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- Right Preview Thumbnail Rounded Card -->
            <FrameLayout
                android:id="@+id/preview_thumbnail_container"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:background="@drawable/bg_photo_preview_default">

                <ImageView
                    android:id="@+id/iv_preview_thumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Photo Preview Thumbnail" />
            </FrameLayout>

        </LinearLayout>

        <!-- Bottom Action Pills: Decline (Charcoal) and Accept (Deep Midnight Navy with Blue Text) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="18dp">

            <!-- Decline Pill Button -->
            <FrameLayout
                android:id="@+id/btn_decline_container"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:background="@drawable/bg_pill_decline"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_btn_decline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Decline"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif" />
            </FrameLayout>

            <!-- Accept Pill Button -->
            <FrameLayout
                android:id="@+id/btn_accept_container"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:background="@drawable/bg_pill_accept_navy"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_btn_accept"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Accept"
                    android:textColor="#2997FF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif" />
            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
